# Main Ghostty config
# Split keybindings into a separate file to keep this easier to scan.

# Keyboard protocol — enables proper shift/ctrl modifier encoding
# so TUI apps (herdr, etc.) can distinguish shifted keybindings on macOS.
kitty-keyboard = true

# Appearance
font-family = "FiraCode Nerd Font Mono"
font-size = 20
theme = "catppuccin-mocha.conf"
cursor-style = "block"

# Window
window-padding-x = 10
window-padding-y = 10
window-decoration = true
confirm-close-surface = false

# Terminal behavior
scrollback-limit = 10000
shell-integration = zsh

# Extra config files
# config-file = keybinds
